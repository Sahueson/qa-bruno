meta {
  name: TC-F01 Anónimo no crea excedencias
  type: http
  seq: 1
}

post {
  url: {{base_url}}/rest/v1/player_leaves
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
}

body:json {
  {"profile_id":"00000000-0000-0000-0000-000000000000","start_date":"2030-01-01","end_date":"2030-01-10"}
}

tests {
  test("TC-F01 Anónimo no crea excedencias", function () {
    const get = (o, p) => p.split('.').reduce((a, k) => (a == null ? a : Array.isArray(a) && !/^\d+$/.test(k) ? a.map((x) => x == null ? x : x[k]) : a[k]), o);
    expect([401,403]).to.include(res.status);
  });
}
