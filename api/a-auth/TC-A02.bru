meta {
  name: TC-A02 Login con contraseña incorrecta falla
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
}

body:json {
  {"email":"qa.player.mad@example.com","password":"contraseña-incorrecta"}
}

tests {
  test("TC-A02 Login con contraseña incorrecta falla", function () {
    const get = (o, p) => p.split('.').reduce((a, k) => (a == null ? a : Array.isArray(a) && !/^\d+$/.test(k) ? a.map((x) => x == null ? x : x[k]) : a[k]), o);
    expect([400]).to.include(res.status);
    expect(res.body.error_code).to.equal("invalid_credentials");
  });
}
