meta {
  name: TC-D01 Anónimo no marca asistencia
  type: http
  seq: 1
}

patch {
  url: {{base_url}}/rest/v1/event_registrations?attended=eq.false
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
}

body:json {
  {"attended":true}
}

tests {
  test("TC-D01 Anónimo no marca asistencia", function () {
    const get = (o, p) => p.split('.').reduce((a, k) => (a == null ? a : Array.isArray(a) && !/^\d+$/.test(k) ? a.map((x) => x == null ? x : x[k]) : a[k]), o);
    expect([401,403]).to.include(res.status);
  });
}
