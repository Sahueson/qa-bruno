meta {
  name: TC-API04 Anónimo no ve faltas FOE (RLS)
  type: http
  seq: 2
}

get {
  url: {{base_url}}/rest/v1/foe_infractions?select=id
  body: none
  auth: none
}

headers {
  apikey: {{anon_key}}
}

tests {
  test("TC-API04 Anónimo no ve faltas FOE (RLS)", function () {
    const get = (o, p) => p.split('.').reduce((a, k) => (a == null ? a : Array.isArray(a) && !/^\d+$/.test(k) ? a.map((x) => x == null ? x : x[k]) : a[k]), o);
    expect([200]).to.include(res.status);
    expect(res.body).to.be.an('array').that.is.empty;
  });
}
