meta {
  name: TC-API16 Jugador MAD no crea partidas en FOE
  type: http
  seq: 16
}

post {
  url: {{base_url}}/rest/v1/events
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{token}}
}

body:json {
  {"title":"QA intrusa","squad":"FOE","date":"2030-01-01","hour":"10:00","event_type":"normal"}
}

script:pre-request {
  if (!bru.getEnvVar('qa_password')) { bru.runner.skipRequest(); return; }
  const axios = require('axios');
  const emails = {"superadmin":"qa.superadmin@example.com","player_mad":"qa.player.mad@example.com","player_foe":"qa.player.foe@example.com","blocked":"qa.blocked@example.com"};
  let token = 'SIN_LOGIN';
  try {
    const r = await axios.post(bru.getEnvVar('base_url') + '/auth/v1/token?grant_type=password',
      { email: emails['player_mad'], password: bru.getEnvVar('qa_password') },
      { headers: { apikey: bru.getEnvVar('anon_key') } });
    token = r.data.access_token;
  } catch (e) { token = 'SIN_LOGIN'; }
  bru.setVar('token', token);
}

tests {
  test("TC-API16 Jugador MAD no crea partidas en FOE", function () {
    expect(bru.getVar('token'), 'login previo').to.not.equal('SIN_LOGIN');
    expect([401,403]).to.include(res.status);
  });
}
