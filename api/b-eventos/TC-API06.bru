meta {
  name: TC-API06 Anónimo no crea partidas
  type: http
  seq: 2
}

post {
  url: {{base_url}}/rest/v1/events
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
}

body:json {
  {"title":"x","date":"2030-01-01","hour":"10:00","field":"x"}
}

tests {
  test("TC-API06 Anónimo no crea partidas", function () {
    const get = (o, p) => p.split('.').reduce((a, k) => (a == null ? a : Array.isArray(a) && !/^\d+$/.test(k) ? a.map((x) => x == null ? x : x[k]) : a[k]), o);
    expect([401,403]).to.include(res.status);
  });
}
