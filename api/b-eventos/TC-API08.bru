meta {
  name: TC-API08 Anónimo no borra partidas
  type: http
  seq: 3
}

delete {
  url: {{base_url}}/rest/v1/events?id=not.is.null
  body: none
  auth: none
}

headers {
  apikey: {{anon_key}}
}

tests {
  test("TC-API08 Anónimo no borra partidas", function () {
    const get = (o, p) => p.split('.').reduce((a, k) => (a == null ? a : Array.isArray(a) && !/^\d+$/.test(k) ? a.map((x) => x == null ? x : x[k]) : a[k]), o);
    expect([401,403]).to.include(res.status);
  });
}
